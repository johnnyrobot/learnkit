{
  "name": "learnkit",
  "version": "1.0.0",
  "description": "LearnKit — a neuroinclusive-coursework kit: evidence-based rules, schemas, and auditors for designing and generating instructional content for any subject.",
  "keywords": [
    "instructional-design",
    "neuroinclusive",
    "neurodivergent",
    "accessibility",
    "coursework",
    "learning-science",
    "udl",
    "wcag",
    "education"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    "import": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts"
  },
  "bin": {
    "learnkit": "dist/bin/learnkit.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "LICENSE-docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "audit": "tsx src/audit-content.ts",
    "audit:sample": "tsx src/audit-content.ts examples/sample-course.json",
    "audit:platform": "tsx src/audit-platform.ts",
    "rules": "tsx bin/learnkit.ts rules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
