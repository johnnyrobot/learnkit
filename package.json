{
  "name": "@johnnyrobot/learnkit",
  "version": "1.0.0",
  "description": "LearnKit — a neuroinclusive-coursework kit: evidence-based rules, schemas, and auditors for designing and generating instructional content for any subject.",
  "keywords": [
    "instructional-design",
    "neuroinclusive",
    "neurodivergent",
    "accessibility",
    "coursework",
    "learning-science",
    "udl",
    "wcag",
    "education"
  ],
  "license": "(MIT AND CC-BY-4.0)",
  "author": "johnnyrobot",
  "homepage": "https://github.com/johnnyrobot/learnkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnnyrobot/learnkit.git"
  },
  "bugs": {
    "url": "https://github.com/johnnyrobot/learnkit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./rules.json": "./docs/RULES.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "learnkit": "./dist/bin/learnkit.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "docs",
    "examples",
    "LICENSE",
    "LICENSE-docs"
  ],
  "scripts": {
    "audit": "tsx src/audit-content.ts",
    "audit:sample": "tsx src/audit-content.ts examples/sample-course.json",
    "audit:flawed": "tsx src/audit-content.ts examples/flawed-course.json",
    "audit:platform": "tsx src/audit-platform.ts",
    "rules": "tsx bin/learnkit.ts rules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
